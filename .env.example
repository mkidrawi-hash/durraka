# ─────────────────────────────────────────────────────────────────────────────
# Durraka Factory — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets to Git.
# Add production values in Vercel → Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Create a free account at https://resend.com and generate an API key.

# Resend API key (starts with re_)
EMAIL_PROVIDER_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Recipient of all internal RFQ notification emails
RFQ_NOTIFICATION_EMAIL=info@durraka.com

# Sender address shown in the notification email.
# Use the Resend shared domain for testing (no domain verification needed).
# For production with a verified durraka.com domain:
#   EMAIL_FROM=Durraka RFQ <noreply@durraka.com>
EMAIL_FROM=Durraka RFQ <onboarding@resend.dev>

# ── Google Sheets (RFQ lead log) ──────────────────────────────────────────────
# Follow the setup guide in README.md → Google Sheets Setup.

# Service account email from your Google Cloud JSON key file
# Example: durraka-rfq@your-project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key from the JSON key file (include BEGIN/END lines).
# Replace literal newlines with \n so the value fits on one line:
# "-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# Spreadsheet ID — found in the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=

# Name of the tab that will receive new rows (must match exactly)
GOOGLE_SHEETS_TAB_NAME=RFQ Submissions
