# ─────────────────────────────────────────────────────────────────────────────
# Durraka Factory — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets to Git.
# Add production values in Vercel → Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Resend (email delivery) ───────────────────────────────────────────────────
# Create an account at https://resend.com and generate an API key.
# For local testing use a Resend test key (emails logged, not delivered).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Internal recipient for all RFQ notification emails
RFQ_INTERNAL_EMAIL=mkidrawi@gmail.com

# ── Google Sheets (RFQ log) ───────────────────────────────────────────────────
# Follow the setup guide in README.md to obtain these values.

# Service account email from your Google Cloud JSON key file
# Example: durraka-rfq@your-project.iam.gserviceaccount.com
GOOGLE_SHEETS_CLIENT_EMAIL=

# Private key from the JSON key file.
# Copy the entire "private_key" value (including BEGIN/END lines).
# Replace actual newlines with \n so it fits on one line:
# "-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_SHEETS_PRIVATE_KEY=

# The spreadsheet ID — found in the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Name of the tab/sheet that will receive new rows (must match exactly)
GOOGLE_SHEETS_TAB_NAME=RFQ Submissions
